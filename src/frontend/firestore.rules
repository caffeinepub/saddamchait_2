rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to safely check if user document exists
    function userDocExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    // Helper function to check if user is super_admin
    function isSuperAdmin() {
      return userDocExists() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }
    
    // Helper function to check if user is helper_admin
    function isHelperAdmin() {
      return userDocExists() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'helper_admin';
    }
    
    // Helper function to check if user is any admin (super_admin or helper_admin)
    function isAdmin() {
      return isSuperAdmin() || isHelperAdmin();
    }
    
    // Helper function to check if user is approved
    function isApproved() {
      return userDocExists() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true;
    }
    
    // Users collection
    match /users/{userId} {
      // Allow read for own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // Allow admins (super_admin and helper_admin) to read all users (for pending list)
      allow read: if isAdmin();
      
      // Allow create during signup - authenticated users can create their own profile
      // This rule is evaluated FIRST and doesn't require the document to exist
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Allow authenticated users to update their own signup profile fields only
      // (fullName, age, relation, phoneNumber, email, photoURL)
      // Cannot update admin-only fields (role, approved, rejected, blocked, createdAt)
      allow update: if isAuthenticated() && 
                       request.auth.uid == userId &&
                       !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['role', 'approved', 'rejected', 'blocked', 'createdAt']);
      
      // Super_admin can update any field
      allow update: if isSuperAdmin();
      
      // Helper_admin can only update approval/rejection status (not role, phone, email)
      allow update: if isHelperAdmin() && 
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'phoneNumber', 'email']);
      
      // Only super_admin can delete profiles
      allow delete: if isSuperAdmin();
    }
    
    // Profile collection (nested under profile/users path)
    match /profile/users/{userId} {
      // Allow authenticated users to create their own profile document
      allow create: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Chat requests collection
    match /chat_requests/{requestId} {
      // Users can read requests they're involved in
      allow read: if isAuthenticated() && 
                     (resource.data.fromUserId == request.auth.uid || 
                      resource.data.toUserId == request.auth.uid);
      
      // Approved users can create requests
      allow create: if isApproved() && 
                       request.resource.data.fromUserId == request.auth.uid;
      
      // Users can update requests they're the recipient of (accept/reject)
      allow update: if isAuthenticated() && 
                       resource.data.toUserId == request.auth.uid;
    }
    
    // Chats collection
    match /chats/{chatId} {
      // Only chat members can read
      allow read: if isAuthenticated() && 
                     request.auth.uid in resource.data.members;
      
      // Approved users can create chats (via accepting requests)
      allow create: if isApproved() && 
                       request.auth.uid in request.resource.data.members;
      
      // Messages subcollection
      match /messages/{messageId} {
        // Only chat members can read messages
        allow read: if isAuthenticated() && 
                       request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        
        // Only chat members can create messages
        allow create: if isAuthenticated() && 
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members &&
                         request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
