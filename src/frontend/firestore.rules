rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Helper function to check if user is admin or super_admin
    function isAdmin() {
      return isAuthenticated() && 
             (getUserData().role == 'admin' || getUserData().role == 'super_admin');
    }
    
    // Helper function to check if user is super_admin
    function isSuperAdmin() {
      return isAuthenticated() && getUserData().role == 'super_admin';
    }
    
    // Users collection rules
    match /users/{userId} {
      // Allow read for own document
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // Allow read for all users if requester is admin
      allow read: if isAdmin();
      
      // Allow create for new users (signup)
      allow create: if isAuthenticated() && 
                       request.auth.uid == userId &&
                       request.resource.data.role != 'super_admin';
      
      // Allow update for own profile (except role and approved fields)
      allow update: if isAuthenticated() && 
                       request.auth.uid == userId &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'approved']);
      
      // Allow admin to update any user's approved status
      allow update: if isAdmin() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved']);
      
      // Allow admin to update role (user <-> admin only, not super_admin)
      allow update: if isAdmin() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
                       request.resource.data.role != 'super_admin' &&
                       resource.data.role != 'super_admin';
      
      // Allow super_admin to update any user including other super_admins
      allow update: if isSuperAdmin();
      
      // Prevent deletion
      allow delete: if false;
    }
  }
}
