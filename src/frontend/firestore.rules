rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'admin'];
    }
    
    // Helper function to check if user is approved
    function isApproved() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true;
    }
    
    // Users collection rules
    match /users/{userId} {
      // Allow read if:
      // - User is reading their own profile, OR
      // - User is an admin
      allow read: if request.auth != null && 
                     (request.auth.uid == userId || isAdmin());
      
      // Allow create only during signup (authenticated user creating their own profile)
      // Only allow setting specific fields during creation
      allow create: if request.auth != null && 
                       request.auth.uid == userId &&
                       request.resource.data.uid == userId &&
                       request.resource.data.email == request.auth.token.email &&
                       // Ensure role and approved are set correctly during creation
                       (request.resource.data.role in ['user', 'super_admin']) &&
                       (request.resource.data.approved is bool);
      
      // Allow update only if:
      // - User is updating their own profile AND not changing role/approved fields, OR
      // - User is an admin (can update any field for any user)
      allow update: if request.auth != null && (
        // Regular users can update their own profile but NOT role or approved
        (request.auth.uid == userId && 
         request.resource.data.role == resource.data.role &&
         request.resource.data.approved == resource.data.approved) ||
        // Admins can update any field for any user
        isAdmin()
      );
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }
    
    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
